CREATE TABLE albums (
    id TEXT NOT NULL PRIMARY KEY,
    album_name TEXT NOT NULL,
    album_thumbnail_asset_id TEXT,
    base_url TEXT NOT NULL,
    share_key TEXT NOT NULL,
    album_id TEXT NOT NULL,
    asset_count INTEGER,
    allow_upload INTEGER AS Boolean NOT NULL DEFAULT 0,
    allow_download INTEGER AS Boolean NOT NULL DEFAULT 1,
    show_metadata INTEGER AS Boolean NOT NULL DEFAULT 1,
    password TEXT,
    provider TEXT NOT NULL DEFAULT 'immich',
    created_at TEXT NOT NULL
);

CREATE TABLE upload_queue (
    id TEXT NOT NULL PRIMARY KEY,
    album_id TEXT NOT NULL,
    album_name TEXT NOT NULL,
    base_url TEXT NOT NULL,
    share_key TEXT NOT NULL,
    password TEXT,
    local_asset_identifier TEXT NOT NULL,
    file_name TEXT NOT NULL,
    file_size INTEGER,
    provider TEXT NOT NULL DEFAULT 'immich',
    created_at TEXT NOT NULL,
    completed_at TEXT,
    status TEXT NOT NULL DEFAULT 'pending',
    progress REAL NOT NULL DEFAULT 0,
    error_message TEXT,
    uploaded_asset_id TEXT
);
